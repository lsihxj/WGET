{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Application": {
    "Port": 3000,
    "EnableScreenshot": true
  },
  "Cache": {
    "CacheTtlSeconds": 604800,
    "TaskRetentionMinutes": 30
  },
  "Crawler": {
    "MaxConcurrent": 5,
    "Timeout": 30000,
    "RetryTimes": 3,
    "RetryDelay": 1000,
    "Headless": true,
    "BrowserPoolSize": 3
  },
  "Api": {
    "CorsOrigin": "*",
    "RateLimit": 10000
  }
}
